rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/repcycle/{documentId} {
      allow read, write: if ownsUserData(userId);
    }
    match /users/{userId}/workoutWeeks/{weekId} {
      allow read, write: if ownsUserData(userId);
    }
    // Retain access to legacy day docs during migration.
    match /users/{userId}/workoutDays/{dayId} {
      allow read, write: if ownsUserData(userId);
    }
    match /users/{userId}/exerciseCatalog/{categoryId} {
      allow read, write: if ownsUserData(userId);
    }
    match /users/{userId}/catalogMeta/{metadataId} {
      allow read, write: if ownsUserData(userId);
    }
  }
}
